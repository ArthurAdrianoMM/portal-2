# Copy to .env, next to compose.yaml, and fill in. .env is ignored by git.

# The address people use: the public hostname of the Cloudflare Tunnel.
PUBLIC_URL=https://portal.example.com

# The tunnel's token: Cloudflare dashboard > Networks > Tunnels > your tunnel > Docker.
TUNNEL_TOKEN=

# Optional: run this version instead of the newest release, as 0.2.0 (to roll back).
# PORTAL2_TAG=latest
